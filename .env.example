# Firebase web app configuration (Firebase Console → Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-side credentials. Use a service account key file or Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=

# LiveKit Cloud project credentials (server only)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Required for cloud recording. Use an S3-compatible bucket accessible to LiveKit Egress.
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=

# Gmail SMTP invitation email using Google OAuth2.
GMAIL_USER=mcameron2909@gmail.com
GMAIL_FROM_NAME=Gather
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Optional, defaults to http://localhost:5173
APP_ORIGIN=http://localhost:5173
# Public frontend URL used in invitation email links (set to deployed site URL in production).
APP_URL=http://localhost:5173
PORT=3001
